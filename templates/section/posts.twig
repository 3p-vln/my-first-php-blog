{% for post in posts %}
    <div class="mb-3" style="border: 1px solid #ddd;">
        <div class="p-3">
            {% if post.image_path is not null %}
                <div style="aspect-ratio: 5 / 2;">
                    <img src="{{ asset_url(post.image_path) }}" class="img-fluid" alt="{{ post.title|escape }}" style="width: 100%; height: 100%; object-fit: cover">
                </div>
            {% endif %}

            <div class="mt-3">
                <a href="{{ url(post.url_key)}}"><h5 class="card-title">{{ post.title|escape }}</h5></a>
                <p class="text-muted">Vladyslava Novak | {{ post.published_date|date("F d, Y") }}</p>
                <p class="mt-2">{{ post.description|escape }}</p>
                <a href="{{ url(post.url_key) }}" class="btn btn-primary">Read more</a>
            </div>
        </div>
    </div>
{% endfor %}