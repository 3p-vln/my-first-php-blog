{% extends 'base.twig' %}

{% block body %}
    <div class="container">
        {% if post.image_path is not null %}
            <img src="{{ asset_url(post.image_path)  }}" class="img-fluid" alt="{{ post.title|escape }}" style="width: 100%;">
        {% endif %}

        <h1 class="mt-3 mb-3">{{ post.title|escape }}</h1>

        <p class="text-muted mb-3">Vladyslava Novak | {{ post.published_date|date("F d, Y") }}</p>

        <p>{{ post.content|raw }}</p>
    </div>
{% endblock %}