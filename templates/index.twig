{% extends 'base.twig' %}

{% block body %}

    <div class="container">
        <h1 class="mb-3 mt-3">Welcome to my first Blog!</h1>

        {% set rowCount = 1 %}
        {% for post in posts %}
            {# 1. Открываем обертку для каждых 3-х карточек #}
            {% if rowCount == 1 %}
                <div class="d-flex flex-wrap gap-3 mb-3">
            {% endif %}

            <div class="card" style="width: 18rem;">
                <img src="https://dummyimage.com/300x200/8a4cb0/ffffff" class="card-img-top" alt="{{ post.title|escape }}">

                <div class="card-body">
                    <a href="{{ post.url_key }}" class="card-title">{{ post.title|escape }}</a>
                    <p class="card-text">{{ post.description|escape }}</p>
                    <a href="{{ post.url_key }}" class="btn btn-primary">Read more</a>
                </div>
            </div>

            {# 2. Закрываем обертку на 3-й карточке ИЛИ на последнем элементе списка #}
            {% if rowCount == 3 or loop.last %}
                </div>
            {% endif %}

            {# 3. Увеличиваем счетчик #}
            {% set rowCount = rowCount + 1 %}
            {% if rowCount > 3 %}
                {% set rowCount = 1 %}
            {% endif %}
        {% endfor %}
    </div>

{% endblock %}